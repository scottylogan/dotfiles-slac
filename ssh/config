#--- github ---

Host github.com
  IdentityFile ~/.ssh/github_rsa


#--- pico.sh ---

Host pico.sh, prose.sh
  IdentityFile ~/.ssh/pico-sh
  IdentitiesOnly yes
  User scotty


#--- SLAC ---

Host iam-ubuntu
  Hostname iam-ubuntu.slac.stanford.edu

Match Host iam-ubuntu.slac.stanford.edu
  User swl
  GSSAPIAuthentication yes
  GSSAPIDelegateCredentials yes
#  ProxyJump none

Host iam-*-*
  Hostname %h.slac.stanford.edu

Match Host iam-*-*.slac.stanford.edu
  User iamoper
  IdentityFile ~/.ssh/id_ed25519

Host jump.slac.stanford.edu
  User swl
  GSSAPIAuthentication yes
  GSSAPIDelegateCredentials yes
  ProxyJump none

Match Host *.slac.stanford.edu
  ProxyJump jump.slac.stanford.edu
  GSSAPIAuthentication yes
  GSSAPIDelegateCredentials yes
  ControlMaster auto
  ControlPath "%d/.ssh/sockets/%n"

#--- local / catbert ---

Host animal
  Hostname animal.local

Host animal.local
  User swl

Host beaker
  Hostname beaker.local

Host beaker.local
  AddressFamily inet

Host *.catbert.net *.local
  User scotty
  ForwardAgent yes
  ForwardX11 no
  SendEnv TERM XAUTHORITY
  IdentityFile ~/.ssh/id_rsa

#--- Stanford ---

Host code.stanford.edu
  User git
  IdentityFile ~/.ssh/github_rsa
  ProxyJump none

Host cardinal cardinal? corn corn??
  HostName %h.stanford.edu

Match Host cardinal1.stanford.edu
  User swl
  GSSAPIAuthentication yes
  GSSAPIDelegateCredentials yes
  ControlPersist yes
  ProxyJump none
  ProxyCommand none

# Host *.stanford.edu !*.slac.stanford.edu !cardinal1.stanford.edu !code.stanford.edu
Match Host *.stanford.edu
  User swl
  ProxyJump swl@cardinal1.stanford.edu
  GSSAPIAuthentication yes
  GSSAPIDelegateCredentials yes
  ControlMaster auto
  ControlPath "%d/.ssh/sockets/%n"


#--- defaults ---

# send keepalive packets every 5 minutes
# keep connections alive for 4 hours
Host * !localhost
  ForwardAgent yes
  ForwardX11 no
  ServerAliveInterval 300
  ServerAliveCountMax 48
  HashKnownHosts yes

Host default
  HostName 127.0.0.1
  User vagrant
  Port 50022
  UserKnownHostsFile /dev/null
  StrictHostKeyChecking no
  PasswordAuthentication no
  IdentityFile /Users/swl/.vagrant.d/insecure_private_key
  IdentitiesOnly yes
  LogLevel FATAL

